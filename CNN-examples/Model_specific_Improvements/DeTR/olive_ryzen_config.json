{
    "workflow_id": "ryzen_workflow",
    "input_model": {
        "type": "OnnxModel",
        "model_path": "detr_resnet50_fp32.onnx",
        "model_attributes": {
            "model_type": "object-detection"
        }
    },
    "systems": {
        "host_system": {
            "type": "LocalSystem",
            "accelerators": [ { "device": "cpu", "execution_providers": [ "CPUExecutionProvider" ] } ]
        },
        "target_system": {
            "type": "LocalSystem",
            "accelerators": [ { "device": "npu", "execution_providers": [ "CPUExecutionProvider" ] } ]
        }
    },
    "data_configs": [
        {
            "name": "quantize_data_config",
            "user_script": "olive_ryzen_data_scripts.py",
            "load_dataset_config": {
                "type": "my_dataset",
                "data_dir": "calibration_dataset/images",
                "transpose": true
            },
            "pre_process_data_config": {
                "type": "my_pre_process"
            },
            "post_process_data_config": {
                "type": "my_post_process"
            }
        }
    ],
    "passes": {
        "onnx_simply": {
            "type": "AMDONNXSIM",
            "model_name": "detr_resnet50_fp32_sim.onnx",
            "tmp_name": "tmp_olive_custom"
        },
        "store_ori_model": {
            "type": "AMDDetrStoreModel",
            "model_name": "detr_resnet50_fp32_ori.onnx",
            "tmp_name": "tmp_olive_custom"
        },
        "remove_const_op": {
            "type": "AMDRemoveConstOp",
            "model_name": "detr_resnet50_fp32_without_const_op.onnx",
            "tmp_name": "tmp_olive_custom"
        },
        "onnxruntime_optimize": {
            "type": "AMDONNXRuntimeOptimize",
            "model_name": "detr_resnet50_fp32_without_const_op_onnruntime_optimized.onnx",
            "tmp_name": "tmp_olive_custom"
        },
        "store_src_model": {
            "type": "AMDDetrStoreModel",
            "model_name": "detr_resnet50_fp32_bak.onnx",
            "tmp_name": "tmp_olive_custom"
        },
        "split_model": {
            "type": "AMDDetrSplitModel",
            "trunk_model_name": "detr_resnet50_fp32_trunk.onnx",
            "tail_model_name": "detr_resnet50_fp32_tail.onnx",
            "split_node_name": "/model/Transpose",
            "tmp_name": "tmp_olive_custom"
        },
        "xint8_redirect_model": {
            "type": "AMDDetrRedirectModel",
            "model_name": "detr_resnet50_fp32_trunk.onnx",
            "tmp_name": "tmp_olive_custom"
        },
        "xint8_quantization": {
            "type": "QuarkQuantization",
            "data_config": "quantize_data_config",
            "global_config": {
                "activation": {
                    "symmetric": true,
                    "calibration_method": "MinMSE",
                    "quant_granularity": "Tensor",
                    "data_type": "Int8"
                },
                "weight": {
                    "symmetric": true,
                    "calibration_method": "MinMax",
                    "quant_granularity": "Tensor",
                    "data_type": "Int8"
                }
            },
            "exclude": [ "/model/Transpose" ],
            "algo_config": [
                {
                    "name": "cle",
                    "cle_steps": 6
                }
            ],
            "extra_options": {
                "SimplifyModel": false,
                "EnableNPUCnn": true,
                "ConvertNCHWToNHWC": true,
                "MinMSEModePof2Scale": "MostCommon",
                "ExecutionProviders": [ "CPUExecutionProvider" ],
                "Int32Bias": false
            }
        },
        "store_xint8_model": {
            "type": "AMDDetrStoreModel",
            "model_name": "detr_resnet50_trunk_xint8.onnx",
            "tmp_name": "tmp_olive_custom"
        },
        "uint16_redirect_model": {
            "type": "AMDDetrRedirectModel",
            "model_name": "detr_resnet50_fp32_ori.onnx",
            "tmp_name": "tmp_olive_custom"
        },
        "uint16_quantization": {
            "type": "QuarkQuantization",
            "data_config": "quantize_data_config",
            "global_config": {
                "activation": {
                    "symmetric": false,
                    "calibration_method": "Percentile",
                    "quant_granularity": "Tensor",
                    "data_type": "UInt16"
                },
                "weight": {
                    "symmetric": true,
                    "calibration_method": "MinMax",
                    "quant_granularity": "Tensor",
                    "data_type": "Int8"
                }
            },
            "exclude": [ "/model/Transpose" ],
            "algo_config": [
                {
                    "name": "cle",
                    "cle_steps": 6
                }
            ],
            "extra_options": {
                "SimplifyModel": false,
                "AdjustBiasScale": false,
                "ConvertNCHWToNHWC": true,
                "Percentile": 99.999,
                "ExecutionProviders": [ "CPUExecutionProvider" ],
                "OptimizeModel": true,
